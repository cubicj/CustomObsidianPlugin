{
  "private": true,
  "workspaces": [
    "cubicj-core",
    "cubicj-plugin-package"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vitest run && npm run build --workspaces",
    "build:core": "npm run build -w cubicj-core",
    "build:package": "npm run build -w cubicj-plugin-package",
    "dev:core": "npm run dev -w cubicj-core",
    "dev:package": "npm run dev -w cubicj-plugin-package"
  },
  "devDependencies": {
    "vitest": "^4.0.18"
  }
}
