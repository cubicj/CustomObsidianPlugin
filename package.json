{
  "name": "cubicj-core",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run watch",
    "build": "node esbuild.config.mjs production",
    "watch": "node esbuild.config.mjs watch",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/modules/frontmatter-dates.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "copy:windows": "node esbuild.config.mjs copy:windows",
    "deploy:windows": "npm run build && npm run copy:windows",
    "dev:windows": "node esbuild.config.mjs watch:windows"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.1",
    "obsidian": "^1.12.3",
    "typescript": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
